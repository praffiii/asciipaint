{
  "name": "asciipaint-day",
  "type": "light",
  "colors": { "editor.background": "#ECE8FF", "editor.foreground": "#0A0D1F" },
  "tokenColors": [
    { "settings": { "foreground": "#0A0D1F" } },
    { "scope": ["keyword", "storage", "keyword.control"], "settings": { "foreground": "#2440D0" } },
    { "scope": ["string", "string.quoted", "punctuation.definition.string"], "settings": { "foreground": "#4B2AA8" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#4B2AA8" } },
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#4A4F7A" } }
  ]
}
