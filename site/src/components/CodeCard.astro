---
import { Code } from "astro:components";
import type { ComponentProps } from "astro/types";
import shikiDayJson from "../../shiki-day.json";
import shikiNightJson from "../../shiki-night.json";
import { uid } from "../lib/uid";
import Keycap from "./Keycap.astro";

type CodeProps = ComponentProps<typeof Code>;

interface Props {
  file: string;
  note?: string;
  /** The code to highlight; without it the card wraps its slot, a block already highlighted (MDX). */
  code?: string;
  lang?: CodeProps["lang"];
  tone?: "dark" | "light";
  /** Renders `code` as plain text in `<pre><code id="code-<file>">`, for client code to replace. */
  live?: boolean;
}
const { file, note, code, lang = "ts", tone = "dark", live = false } = Astro.props;
const theme: CodeProps["theme"] = tone === "dark" ? { ...shikiNightJson, type: "dark" } : { ...shikiDayJson, type: "light" };
const name = `code-${file.replace(/\W+/g, "-")}`;
// A live card's id is fixed for the client code that fills it; the rest are numbered, as a page can repeat a file name.
const id = live ? name : uid(name);
---

<figure class={`card card-${tone}`}>
  <figcaption class="card-head">
    <span class="card-file">{file}</span>
    {note && <span class="card-note">{note}</span>}
    <Keycap size="sm" data-copy={id} aria-label={`Copy ${file}`}>[ copy ]</Keycap>
  </figcaption>
  {
    code === undefined ? (
      <div id={id}><slot /></div>
    ) : live ? (
      <pre class="card-live" tabindex="0"><code id={id}>{code}</code></pre>
    ) : (
      <Code id={id} code={code} lang={lang} theme={theme} />
    )
  }
</figure>

<script>
  import { wireCopy } from "../lib/copy";
  wireCopy(document);
</script>

<style>
  .card {
    margin: 0;
    --focus: var(--blue-light);
    border: 1.5px solid var(--cobalt);
    box-shadow: var(--slab) var(--slab) 0 var(--card-edge, var(--cobalt));
    background: var(--navy);
    color: var(--lavender);
    min-width: 0;
  }
  /* Light: a black file tab on top of a lavender slab, the copy key inside its top right corner. */
  .card-light {
    --head: 28px;
    position: relative;
    border: 0;
    box-shadow: none;
    background: none;
    color: var(--navy);
    --focus: var(--cobalt);
  }
  .card-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    background: var(--ink-2);
    font: 500 12px/1 var(--font-mono);
    letter-spacing: 0.04em;
  }
  .card-light .card-head {
    width: fit-content;
    max-width: 100%;
    min-height: var(--head);
    padding-block: 0;
    background: var(--black);
    color: var(--lavender);
    --keycap-edge: var(--cobalt);
  }
  .card-light .card-head :global(.keycap) {
    position: absolute;
    top: calc(var(--head) + var(--space-3));
    right: var(--space-3);
  }
  .card-light :global(pre) {
    border: 1.5px solid var(--black);
    box-shadow: var(--slab) var(--slab) 0 var(--cobalt);
    background: var(--lavender) !important;
  }
  .card-note {
    flex: 1;
    text-transform: uppercase;
    color: var(--muted);
  }
  .card-light .card-note {
    color: var(--blue-light);
  }
  .card-file {
    flex: none;
  }
  .card-head :global(.keycap) {
    margin-left: auto;
  }
  /* The copy key: a dark keycap, outlined in lavender on a dark card. */
  .card-dark .card-head {
    --keycap-edge: var(--cobalt);
  }
  .card-dark .card-head :global(.keycap) {
    border-color: var(--lavender);
  }
  .card :global(pre) {
    margin: 0;
    padding: var(--space-3);
    overflow-x: auto;
    font: 400 14px/1.6 var(--font-mono);
    background: transparent !important;
    color: inherit;
  }
  .card :global(pre code) {
    font: inherit;
  }
  /* Phone code is 13 px, as in the phone frames, so their lines fit the card. */
  @media (max-width: 639px) {
    .card :global(pre) {
      padding-inline: 12px;
      font-size: 13px;
    }
  }
</style>
