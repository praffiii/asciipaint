---
import { Code } from "astro:components";
import type { ComponentProps } from "astro/types";
import shikiNightJson from "../../shiki-night.json";
import { uid } from "../lib/uid";
import Keycap from "./Keycap.astro";

type CodeProps = ComponentProps<typeof Code>;

interface Props {
  file: string;
  note?: string;
  /** The code to highlight; without it the card wraps its slot, a block already highlighted (MDX). */
  code?: string;
  lang?: CodeProps["lang"];
  /** Renders `code` as plain text in `<pre><code id="code-<file>">`, for client code to replace. */
  live?: boolean;
}
const { file, note, code, lang = "ts", live = false } = Astro.props;
const theme: CodeProps["theme"] = { ...shikiNightJson, type: "dark" };
const name = `code-${file.replace(/\W+/g, "-")}`;
// A live card's id is fixed for the client code that fills it; the rest are numbered, as a page can repeat a file name.
const id = live ? name : uid(name);
---

<figure class="card">
  <figcaption class="card-head">
    <span class="card-file">{file}</span>
    {note && <span class="card-note">{note}</span>}
    <Keycap size="sm" data-copy={id} aria-label={`Copy ${file}`}><span data-copied="copied">copy</span></Keycap>
  </figcaption>
  {
    code === undefined ? (
      <div id={id}><slot /></div>
    ) : live ? (
      <pre class="card-live" tabindex="0"><code id={id}>{code}</code></pre>
    ) : (
      <Code id={id} code={code} lang={lang} theme={theme} />
    )
  }
</figure>

<script>
  import { wireCopy } from "../lib/copy";
  wireCopy(document);
</script>

<style>
  /* Code on a hairline: the file name and the copy tag on one line over it. */
  .card {
    margin: 0;
    --focus: var(--lavender);
    border: 1px solid var(--line);
    background: var(--black);
    color: var(--lavender);
    min-width: 0;
  }
  .card-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--line);
    font: 500 11px/13px var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .card-note {
    flex: 1;
    text-transform: uppercase;
    color: var(--muted-light);
  }
  .card-file {
    flex: none;
  }
  .card-head :global(.keycap) {
    margin-left: auto;
  }
  .card :global(pre) {
    margin: 0;
    padding: var(--space-3);
    overflow-x: auto;
    font: 400 14px/1.6 var(--font-mono);
    background: transparent !important;
    color: inherit;
  }
  .card :global(pre code) {
    font: inherit;
  }
  /* Phone code is 13 px, so the docs' lines fit the card. */
  @media (max-width: 639px) {
    .card :global(pre) {
      padding-inline: 12px;
      font-size: 13px;
    }
  }
</style>
