---
import { TONES, type Tone } from "../lib/tones";

interface Props {
  text: string;
  palette: "light" | "title";
  band: Tone;
  as?: "h2" | "p";
}
const { text, palette, band, as: Tag = "h2" } = Astro.props;
---

<div class="painted-title" data-palette={palette} data-band={TONES[band]}>
  <Tag class="painted-text">{text}</Tag>
  <div class="painted-still" aria-hidden="true"></div>
</div>

<script>
  import { isPalette, liquid, type Palette } from "../lib/liquid";
  import { paintStill } from "../lib/still";

  const family = getComputedStyle(document.documentElement).getPropertyValue("--font-display").trim() || "serif";

  /** The liquid at t = 11, cut out by the text: 98% of the width, baseline at 80% of the height. */
  function titleCanvas(text: string, palette: Palette, w: number, h: number): HTMLCanvasElement {
    const canvas = document.createElement("canvas");
    canvas.width = Math.round(w);
    canvas.height = Math.round(h);
    const ctx = canvas.getContext("2d");
    if (!ctx) return canvas;
    const frame = liquid()?.frame(11, canvas.width, canvas.height, palette);
    if (frame) ctx.drawImage(frame, 0, 0);
    ctx.globalCompositeOperation = "destination-in";
    ctx.font = `900 100px ${family}`;
    const size = (100 * 0.98 * canvas.width) / ctx.measureText(text).width;
    ctx.font = `900 ${size}px ${family}`;
    ctx.textAlign = "center";
    ctx.fillText(text, canvas.width / 2, canvas.height * 0.8);
    return canvas;
  }

  document.querySelectorAll<HTMLElement>(".painted-title").forEach(async (box) => {
    const host = box.querySelector<HTMLElement>(".painted-still");
    const text = box.querySelector(".painted-text")?.textContent ?? "";
    const palette = box.dataset.palette;
    if (!host || !text || !isPalette(palette) || !liquid()) return; // the HTML text stays as it is
    await document.fonts.load(`900 100px ${family}`);
    // `paint` doesn't bubble, so the host catches it on the way down.
    host.addEventListener("paint", () => (box.dataset.painted = ""), { capture: true, once: true });
    paintStill(host, (w, h) => titleCanvas(text, palette, w, h), { background: box.dataset.band ?? "#000000" });
  });
</script>

<style>
  .painted-title {
    position: relative;
    display: inline-block;
  }
  .painted-text {
    margin: 0;
    font: 900 var(--display-lg) / 1 var(--font-display);
    letter-spacing: -0.015em;
  }
  .painted-still {
    position: absolute;
    inset: 0;
  }
  .painted-still :global(ascii-img) {
    display: block;
  }
  .painted-title[data-painted] .painted-text {
    color: transparent;
  }
</style>
