---
import Band from "../components/Band.astro";
import CodeCard from "../components/CodeCard.astro";
import Ticker from "../components/Ticker.astro";
import Base from "../layouts/Base.astro";
import Hero from "../sections/Hero.astro";

const cdn = `<script type="module">
  import { asciipaint }
    from "https://esm.sh/asciipaint";
</script>`;
---

<Base title="asciipaint">
  <main id="main">
    <Hero />
    <Ticker />
    <Band tone="lavender" grain edgeBelow="cobalt">
      <CodeCard file="index.html" note="OR STRAIGHT FROM A CDN" code={cdn} lang="html" tone="dark" />
    </Band>
  </main>
</Base>
