---
import { getCollection, render } from "astro:content";
import CodePre from "../../components/CodePre.astro";
import Docs from "../../layouts/Docs.astro";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Docs slug={entry.id} title={entry.data.title} description={entry.data.description} source={entry.filePath ?? `src/content/docs/${entry.id}.mdx`}>
  <Content components={{ pre: CodePre }} />
</Docs>
