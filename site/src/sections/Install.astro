---
import { agentPrompt } from "../data/agent-prompt";
import { MANAGERS } from "../lib/install";

const managers = Object.keys(MANAGERS) as (keyof typeof MANAGERS)[];
---

<section class="install" id="install" aria-labelledby="install-title">
  <h2 id="install-title" class="sr">Install</h2>

  <div class="row">
    <p class="label"><i>01</i> INSTALL</p>
    <div class="body">
      <div class="tabs" role="tablist" aria-label="Package manager">
        {
          managers.map((name, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${name}`}
              data-manager={name}
              aria-selected={i === 0}
              aria-controls="install-panel"
              tabindex={i === 0 ? 0 : -1}
            >
              {name}
            </button>
          ))
        }
      </div>
      <div class="cmd" id="install-panel" role="tabpanel" aria-labelledby="tab-npm">
        <code id="install-command"><span class="prompt">$</span> <span id="install-cmd">{MANAGERS.npm}</span><span class="caret" aria-hidden="true"></span></code>
        <button type="button" class="copy" data-copy="install-cmd" aria-label="Copy install command"><span data-copied="copied">copy</span></button>
      </div>
      <p class="foot agent">
        <button type="button" class="copy" data-copy="agent-prompt" aria-label="Copy a prompt for your AI agent"><span data-copied="copied">copy a prompt for your agent</span></button>
        <a href="/llms.txt">llms.txt →</a>
      </p>
      <pre id="agent-prompt" hidden>{agentPrompt(Astro.site!.origin)}</pre>
    </div>
  </div>

  <div class="row">
    <p class="label"><i>02</i> PAINT</p>
    <div class="body paint">
      <div class="code">
        <pre><code id="paint-code"><span class="ln"><b>import</b> {"{ asciipaint }"} <b>from</b> <q>"asciipaint"</q>;</span>
<span class="ln"><b>const</b> paint = asciipaint(canvas);</span>
<span class="ln">paint.draw(picture);</span></code></pre>
        <p class="foot">
          <button type="button" class="copy" data-copy="paint-code" aria-label="Copy the three lines"><span data-copied="copied">copy</span></button>
          <a href="/docs/install/">No bundler? Import it from a CDN →</a>
        </p>
      </div>
      <figure class="result">
        <canvas data-install-demo aria-hidden="true"></canvas>
        <figcaption>WHAT THOSE THREE LINES PAINT<span class="live"> · LIVE</span></figcaption>
      </figure>
    </div>
  </div>
</section>

<script>
  import { install } from "../lib/install";
  install(document);
</script>

<style>
  /* The hero's language carried on: black, hairlines, small type. */
  .install {
    background: var(--black);
    color: var(--lavender);
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .row {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: var(--space-4);
    padding: 28px max(16px, 2.2vw);
    border-top: 1px solid var(--line);
  }
  .label {
    margin: 0;
    font: 500 11px/13px var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .label i {
    margin-right: 8px;
    font-style: normal;
    color: var(--lilac);
  }
  .body {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
  }
  button {
    padding: 0;
    border: 0;
    background: none;
    font: 500 12px/1 var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--muted);
    cursor: pointer;
  }
  .tabs {
    display: flex;
    gap: var(--space-4);
  }
  .tabs button {
    padding-bottom: 6px;
    border-bottom: 1px solid transparent;
  }
  .tabs button[aria-selected="true"] {
    border-color: var(--lavender);
    color: var(--lavender);
  }
  .cmd {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    font: 500 20px/1.2 var(--font-mono);
  }
  .cmd code {
    font: inherit;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .prompt {
    color: var(--muted);
  }
  .caret {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 6px;
    vertical-align: text-bottom;
    background: var(--violet);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .copy {
    color: var(--lilac);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  button:hover,
  .foot a:hover {
    color: var(--lavender);
  }
  button:focus-visible,
  .foot a:focus-visible {
    outline: 1px solid var(--lavender);
    outline-offset: 4px;
  }
  @media (prefers-reduced-motion: no-preference) {
    button,
    .foot a {
      transition: color 150ms ease;
    }
  }

  .paint {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    gap: var(--space-5);
  }
  .code {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
  }
  pre {
    margin: 0;
    overflow-x: auto;
    counter-reset: line;
    font: 400 15px/26px var(--font-mono);
  }
  pre code {
    font: inherit;
  }
  /* The numbers are drawn, not text, so the copied code is clean. */
  .ln::before {
    counter-increment: line;
    content: counter(line);
    display: inline-block;
    width: 28px;
    color: var(--muted-light);
  }
  .ln b {
    font-weight: 400;
    color: var(--lilac);
  }
  .ln q {
    quotes: none;
    color: var(--blue-light);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    font: 500 12px/1 var(--font-mono);
    letter-spacing: 0.04em;
  }
  /* The agent line is its own thing, not part of the package manager tabs above it. */
  .agent {
    margin-top: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }
  .foot a {
    color: var(--muted);
    text-decoration: none;
  }
  .result {
    display: grid;
    gap: var(--space-2);
    margin: 0;
  }
  .result canvas {
    display: block;
    width: 100%;
    height: 220px;
    background: var(--navy);
  }
  figcaption {
    font: 500 11px/13px var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  /* Nothing painted, so nothing to show or caption. */
  .result[data-fallback] {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .live {
      display: none;
    }
  }

  @media (max-width: 899px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
      padding: 24px 16px;
    }
    .paint {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
    }
    .cmd {
      font-size: 16px;
    }
    pre {
      font-size: 13px;
    }
    .result canvas {
      height: 180px;
    }
  }
</style>
