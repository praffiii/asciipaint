---
import { CELL_RANGE, DEFAULT_SETTINGS as d, SWATCHES } from "../lib/playground/settings";
import { snippet } from "../lib/playground/snippet";

interface Props {
  /** The full-screen shell: the stage fills the viewport above the controls, and the whole page takes drops. */
  full?: boolean;
}
const { full = false } = Astro.props;

const sources = [
  { kind: "liquid", label: "Liquid paint" },
  { kind: "three", label: "3D scene" },
  { kind: "camera", label: "Camera" },
  { kind: "file", label: "Your picture" },
] as const;
const swatchNames = ["Black", "Navy", "Lavender", "Deep blue", "Violet"];
const fill = (100 * (d.cell[0] - CELL_RANGE.min)) / (CELL_RANGE.max - CELL_RANGE.min);
const sub = "Drop your own picture onto the stage. It is painted on your machine and never uploaded.";
---

<section class="pgs" id="playground" aria-labelledby="pg-title">
  <div class:list={["pg", { "pg-full": full }]} data-playground={full ? "full" : "inline"}>
    <header class="head">
      {
        full ? (
          <p class="label"><a href="/">← asciipaint</a></p>
          <div class="say"><h1 id="pg-title">Playground</h1><p class="sub">{sub}</p></div>
        ) : (
          <h2 class="label" id="pg-title"><i>03</i> PLAYGROUND</h2>
          <p class="sub">{sub}</p>
        )
      }
    </header>

    <div class="stage" data-stage>
      <canvas data-stage-flat role="img" aria-label="The painted stage"></canvas>
      <canvas data-stage-solid role="img" aria-label="The painted 3D scene" hidden></canvas>
      <p class="stage-hud stage-hud-live" aria-hidden="true"><span class="dot"></span>LIVE · 30 FPS</p>
      <p class="stage-hud stage-hud-cells" data-cells>— × — CELLS</p>
      <div class="drop">
        <span aria-hidden="true">↓</span>
        <span>DROP A PICTURE<span class="wide"> ANYWHERE</span></span>
        <span aria-hidden="true">·</span>
        <button type="button" class="link" data-browse aria-label="Browse for a picture">BROWSE</button>
        <input type="file" accept="image/*,.glb,.gltf" data-file aria-label="Your picture" hidden />
      </div>
    </div>

    <div class="console">
      <div role="group" aria-labelledby="pg-source">
        <p class="label" id="pg-source">SOURCE</p>
        <div class="choices">
          {
            sources.map((s) => (
              <button type="button" class="choice" data-source={s.kind} aria-pressed={s.kind === "liquid" ? "true" : "false"}>
                {s.label}
              </button>
            ))
          }
        </div>
      </div>

      <div class="cell">
        <label class="label" for="pg-cell">CELL SIZE</label>
        <output class="value" for="pg-cell" data-cell-out>{d.cell[0]} × {d.cell[1]} PX</output>
        <input
          id="pg-cell"
          type="range"
          min={CELL_RANGE.min}
          max={CELL_RANGE.max}
          step={CELL_RANGE.step}
          value={d.cell[0]}
          aria-valuetext={`${d.cell[0]} × ${d.cell[1]} px`}
          style={`--fill: ${fill}%`}
          data-cell
        />
      </div>

      <div class="ramp">
        <p class="label" id="pg-ramp">RAMP <span aria-hidden="true">·</span> DARK → BRIGHT</p>
        <div class="keys" role="group" aria-labelledby="pg-ramp" data-ramp-keys>
          {
            Array.from(d.ramp, (glyph, i) => (
              <button type="button" class="glyph" data-glyph={i}>
                {glyph}
              </button>
            ))
          }
        </div>
        <input
          class="ramp-input"
          type="text"
          value={d.ramp}
          aria-label="Ramp, dark to bright"
          aria-describedby="pg-message"
          aria-invalid="false"
          spellcheck="false"
          autocomplete="off"
          data-ramp-input
          hidden
        />
        <button type="button" class="link edit" data-edit>EDIT</button>
      </div>

      <div role="group" aria-labelledby="pg-background">
        <p class="label" id="pg-background">BACKGROUND</p>
        <div class="swatches">
          {
            SWATCHES.map((hex, i) => (
              <button
                type="button"
                class="swatch"
                style={`--swatch: ${hex}`}
                aria-label={`${swatchNames[i]} ${hex}`}
                aria-pressed={hex === d.background ? "true" : "false"}
                data-swatch={hex}
              />
            ))
          }
        </div>
      </div>

      <div role="group" aria-labelledby="pg-sparkle">
        <p class="label" id="pg-sparkle">SPARKLE</p>
        <div class="choices">
          <button type="button" class="choice" aria-pressed={d.sparkle ? "true" : "false"} data-sparkle="on">ON</button>
          <button type="button" class="choice" aria-pressed={!d.sparkle ? "true" : "false"} data-sparkle="off">OFF</button>
        </div>
      </div>
    </div>
    <p class="message" id="pg-message" role="status" data-message></p>

    <div class="snippet">
      <div class="about">
        <p class="label">YOUR SETTINGS<span class="card-note">updates as you drag</span></p>
        <button type="button" class="link" data-copy="code-your-settings-ts" aria-label="Copy your-settings.ts"><span data-copied="copied">copy</span></button>
      </div>
      <pre tabindex="0"><code id="code-your-settings-ts">{snippet(d, "liquid", false)}</code></pre>
    </div>
  </div>
</section>

<script>
  // The playground's module (and three.js after it) loads only when it's needed: at once on its own
  // page, or when the landing's section scrolls within 800 px.
  import { wireCopy } from "../lib/copy";
  const root = document.querySelector<HTMLElement>("[data-playground]");
  if (root) {
    wireCopy(root);
    // Offline, or a stale chunk after a redeploy: say so on the message line rather than die silently.
    const load = () =>
      void import("../lib/playground/playground")
        .then(({ playground }) => playground(root))
        .catch((error: unknown) => {
          console.warn("The playground couldn't load.", error);
          const message = root.querySelector("[data-message]");
          if (message) message.textContent = "The playground couldn't load. Check your connection, then reload.";
          root.dataset.fallback = "";
        });
    if (root.dataset.playground === "full") load();
    else {
      const near = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          near.disconnect();
          load();
        },
        { rootMargin: "800px" },
      );
      near.observe(root);
    }
  }
</script>

<style>
  /* The hero's language carried on: black, hairlines, small type. The stage is the only loud thing. */
  .pgs {
    --focus: var(--lavender);
    background: var(--black);
    color: var(--lavender);
  }
  .pg [hidden] {
    display: none !important;
  }
  .head,
  .console,
  .snippet {
    padding: 28px max(16px, 2.2vw);
    border-top: 1px solid var(--line);
  }
  .head,
  .snippet {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: var(--space-4);
  }
  .label {
    margin: 0;
    font: 500 11px/13px var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .label i {
    margin-right: 8px;
    font-style: normal;
    color: var(--lilac);
  }
  .label a {
    color: var(--lilac);
    text-decoration: none;
  }
  .sub {
    max-width: 62ch;
    margin: 0;
    font: 400 15px/23px var(--font-body);
    color: var(--muted);
  }
  .say {
    display: grid;
    gap: var(--space-2);
  }
  h1 {
    font-size: 30px;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .stage {
    position: relative;
    height: min(72svh, 640px);
    min-height: 320px;
    background: var(--black);
    border-top: 1px solid var(--line);
  }
  .stage.is-dragging {
    outline: 1px dashed var(--lavender);
    outline-offset: -10px;
  }
  .stage canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  .stage-hud,
  .drop {
    position: absolute;
    margin: 0;
    padding: 7px 10px;
    background: var(--black);
    font: 500 11px/13px var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--lavender);
    white-space: nowrap;
  }
  .stage-hud {
    top: 20px;
    pointer-events: none;
  }
  .stage-hud-live {
    left: max(16px, 2.2vw);
  }
  .stage-hud-cells {
    right: max(16px, 2.2vw);
  }
  .dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 8px;
    background: var(--violet);
  }
  .pg[data-fallback] .stage-hud {
    display: none;
  }
  /* A still picture, or one held frame under reduced motion, isn't live. */
  .pg[data-painting="file"] .stage-hud-live {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .stage-hud-live {
      display: none;
    }
  }
  .drop {
    left: max(16px, 2.2vw);
    bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  button {
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    font: 500 12px/1 var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--muted);
    cursor: pointer;
  }
  .link {
    color: var(--lilac);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  button:hover {
    color: var(--lavender);
  }
  @media (prefers-reduced-motion: no-preference) {
    button {
      transition: color 150ms ease;
    }
  }

  /* The controls: one strip under the stage, a small label over each. */
  .console {
    display: grid;
    grid-template-columns: auto minmax(180px, 1fr) minmax(0, 1.3fr) auto auto;
    align-items: start;
    gap: var(--space-4) var(--space-5);
  }
  .console .label {
    display: block;
    margin-bottom: 14px;
  }
  .choices {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }
  .choice {
    padding-bottom: 6px;
    border-bottom: 1px solid transparent;
    white-space: nowrap;
  }
  .choice[aria-pressed="true"] {
    border-color: var(--lavender);
    color: var(--lavender);
  }

  .cell {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
  }
  .value {
    font: 500 11px/13px var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--lilac);
  }
  .cell input {
    grid-column: 1 / -1;
    width: 100%;
    height: 18px;
    margin: 0;
    appearance: none;
    background:
      linear-gradient(var(--lavender), var(--lavender)) 0 50% / var(--fill) 1px no-repeat,
      linear-gradient(var(--line), var(--line)) 0 50% / 100% 1px no-repeat;
    cursor: pointer;
  }
  .cell input::-webkit-slider-thumb {
    appearance: none;
    width: 9px;
    height: 17px;
    background: var(--lavender);
  }
  .cell input::-moz-range-thumb {
    width: 9px;
    height: 17px;
    border: 0;
    border-radius: 0;
    background: var(--lavender);
  }

  .ramp {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: "label edit" "keys keys";
    align-items: baseline;
  }
  .ramp .label {
    grid-area: label;
  }
  .keys,
  .ramp-input {
    grid-area: keys;
  }
  .keys {
    display: flex;
    flex-wrap: wrap; /* a long ramp makes rows, never a sideways scroll */
    gap: 4px;
  }
  .keys :global(.glyph) {
    display: grid;
    place-items: center;
    width: 26px;
    height: 30px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 0;
    background: none;
    font: 500 15px/1 var(--font-mono);
    color: var(--lavender);
    cursor: pointer;
  }
  .keys :global(.glyph:hover) {
    border-color: var(--lavender);
  }
  .ramp-input {
    height: 30px;
    padding: 0 10px;
    border: 1px solid var(--line);
    border-radius: 0;
    background: none;
    color: var(--lavender);
    font: 500 15px/1 var(--font-mono);
    letter-spacing: 0.2em;
  }
  .ramp-input[aria-invalid="true"] {
    border-color: var(--violet);
  }
  .edit {
    grid-area: edit;
  }

  .swatches {
    display: flex;
    gap: 8px;
  }
  .swatch {
    width: 20px;
    height: 20px;
    border: 1px solid var(--line);
    background: var(--swatch);
  }
  .swatch[aria-pressed="true"] {
    outline: 1px solid var(--lavender);
    outline-offset: 3px;
  }
  .message {
    min-height: 1.4em;
    margin: 0;
    padding: 0 max(16px, 2.2vw) 20px;
    font: 500 12px/1.4 var(--font-mono);
    color: var(--lilac);
  }
  .message:empty {
    min-height: 0;
    padding-bottom: 0;
  }

  /* The settings as code; its tokens are spans made client-side, so global. */
  .card-note {
    display: block;
    margin-top: 8px;
    color: var(--muted-light);
    text-transform: uppercase;
  }
  .about {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-3);
  }
  pre {
    min-width: 0;
    margin: 0;
    overflow-x: auto;
    font: 400 15px/26px var(--font-mono);
  }
  pre code {
    font: inherit;
  }
  .snippet :global(.tok-keyword) {
    color: var(--lilac);
  }
  .snippet :global(.tok-literal) {
    color: var(--blue-light);
  }
  .snippet :global(.tok-punctuation) {
    color: var(--muted);
  }

  /* Full screen: the stage takes what the viewport has left above the controls. */
  .pg-full .head {
    border-top: 0;
  }
  @media (min-width: 1100px) {
    .pg-full .stage {
      height: max(360px, calc(100svh - 330px));
    }
  }

  @media (max-width: 1099px) {
    .console {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 899px) {
    .head,
    .snippet {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
      padding: 24px 16px;
    }
    .console {
      padding: 24px 16px;
    }
  }
  @media (max-width: 640px) {
    .console {
      grid-template-columns: minmax(0, 1fr);
    }
    .stage {
      height: 60svh;
    }
    .stage-hud-cells,
    .wide {
      display: none;
    }
    .stage-hud {
      top: 12px;
    }
    .drop {
      bottom: 12px;
    }
    pre {
      font-size: 13px;
    }
  }
</style>
