---
import pkg from "../../../package.json";

const links = [
  { label: "Docs", href: "/docs/" },
  { label: "GitHub ↗", href: "https://github.com/praffiii/asciipaint" },
  { label: "npm ↗", href: "https://www.npmjs.com/package/asciipaint" },
  { label: "MIT licence", href: "https://github.com/praffiii/asciipaint/blob/main/LICENSE" },
];
---

<footer class="foot">
  <p class="name">ASCIIPAINT <span>{pkg.version}</span></p>
  <p class="note">Every picture on this page is painted live by the library.</p>
  <nav class="links" aria-label="Project">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
</footer>

<style>
  .foot {
    --focus: var(--lavender);
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-3) var(--space-4);
    padding: 28px max(16px, 2.2vw) 40px;
    border-top: 1px solid var(--line);
    background: var(--black);
    font: 500 11px/13px var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  p {
    margin: 0;
  }
  .name {
    color: var(--lavender);
  }
  .name span {
    color: var(--lilac);
  }
  .note {
    font: 400 15px/23px var(--font-body);
    letter-spacing: 0;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }
  a {
    color: var(--lilac);
    text-decoration: none;
  }
  a:hover {
    color: var(--lavender);
  }
  @media (prefers-reduced-motion: no-preference) {
    a {
      transition: color 150ms ease;
    }
  }
  @media (max-width: 899px) {
    .foot {
      grid-template-columns: minmax(0, 1fr);
      padding: 24px 16px 32px;
    }
  }
</style>
