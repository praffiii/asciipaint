---
import Keycap from "../components/Keycap.astro";

---

<section class="hero" aria-labelledby="hero-title">
  <div class="field" data-field aria-hidden="true">
    <canvas data-hero-painted></canvas>
    <p class="readout" data-readout><span class="dot"></span><span class="wide">CELLS </span>24 × 36 → 3 × 4.5<span class="live"> · <span data-resolved>0%</span> RESOLVED · LIVE</span></p>
  </div>
  <div class="strip">
    <div class="say">
      <h1 id="hero-title">Paint anything as coloured ASCII.</h1>
      <p class="facts">
        ~6 KB <span class="sep">·</span> <span class="wide">ZERO DEPENDENCIES</span><span class="narrow">ZERO DEPS</span> <span class="sep">·</span> WEBGL2
      </p>
    </div>
    <p class="sub">
      Any image, video, canvas or three.js scene, painted in coloured glyphs. Move across the picture above to resolve it.
    </p>
    <div class="keys">
      <Keycap data-copy="hero-npm" aria-label="Copy npm i asciipaint">$ <span id="hero-npm">npm i asciipaint</span> <span aria-hidden="true" data-copied="✓">⧉</span></Keycap>
      <Keycap href="#playground" tone="violet"><span class="wide">Try your picture</span><span class="narrow">Try it</span> ↓</Keycap>
    </div>
  </div>
</section>

<script>
  import { hero } from "../lib/hero";
  import { paintIn } from "../lib/paint-in";
  const root = document.querySelector<HTMLElement>(".hero");
  const title = document.querySelector<HTMLElement>("#hero-title");
  if (title) paintIn(title);
  if (root) hero(root);
</script>

<style>
  /* The painting fills the first screen; the pitch is one quiet strip under it. */
  .hero {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    height: 100svh;
    min-height: 600px;
    background: var(--black);
  }
  .field {
    position: relative;
    overflow: hidden;
    touch-action: pan-y;
    cursor: crosshair;
  }
  .field canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 400ms;
  }
  .hero[data-live] .field canvas,
  .hero[data-fallback="source"] .field canvas {
    opacity: 1;
  }
  .hero[data-fallback="gradient"] .field {
    background: linear-gradient(125deg, #0e1a5c, #2440d0 40%, #7c5cf2 70%, #3b1e9a);
  }
  .readout {
    position: absolute;
    left: max(16px, 2.2vw);
    bottom: 20px;
    margin: 0;
    padding: 7px 10px;
    background: var(--black);
    font: 500 11px/13px var(--font-mono);
    letter-spacing: 0.06em;
    white-space: nowrap;
    color: var(--lavender);
  }
  .dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 8px;
    background: var(--violet);
  }
  /* Not painting: no claim about cells. Holding one frame under reduced motion: no claim of LIVE. */
  .hero[data-fallback] .readout {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .live {
      display: none;
    }
  }

  .strip {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-5);
    padding: 26px max(16px, 2.2vw);
    border-top: 1px solid var(--line);
  }
  .say {
    display: grid;
    gap: 10px;
  }
  h1 {
    font-size: 30px;
    line-height: 1.1;
    letter-spacing: -0.01em;
    white-space: nowrap;
    color: var(--lavender);
  }
  .facts {
    margin: 0;
    font: 500 11px/13px var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--lilac);
  }
  .sep {
    margin: 0 6px;
  }
  .sub {
    max-width: 52ch;
    margin: 0;
    font: 400 15px/23px var(--font-body);
    color: var(--muted);
  }
  .keys {
    display: flex;
    gap: 14px;
  }
  .narrow {
    display: none;
  }

  /* Load: the strip comes in piece by piece under the painting, which fades in when it first draws. */
  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 10px;
    }
  }
  @keyframes appear {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .facts,
    .sub,
    .keys {
      animation: rise 500ms var(--ease-out) backwards;
    }
    h1 {
      animation: appear 300ms ease 60ms backwards;
    }
    .sub {
      animation-delay: 120ms;
    }
    .keys {
      animation-delay: 180ms;
    }
    .readout {
      animation: appear 400ms ease 650ms backwards;
    }
  }
  /* A letter still being painted in (lib/paint-in.ts): hidden under the ramp glyph it has reached. */
  h1 :global([data-g]) {
    position: relative;
    -webkit-text-fill-color: transparent;
  }
  h1 :global([data-g])::after {
    content: attr(data-g);
    content: attr(data-g) / "";
    position: absolute;
    left: 0;
    right: 0;
    text-align: center;
    font: 500 0.62em/1.6 var(--font-mono);
    -webkit-text-fill-color: var(--violet);
  }

  @media (max-width: 1280px) {
    .strip {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .sub {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .strip {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
      padding: 20px 16px 24px;
    }
    h1 {
      font-size: 26px;
      white-space: normal;
    }
    .sub {
      display: block;
    }
    .wide {
      display: none;
    }
    .narrow {
      display: inline;
    }
    .readout {
      bottom: 12px;
    }
  }
</style>
