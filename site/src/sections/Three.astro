---
import PlainCode from "../components/PlainCode.astro";

const code = `import { asciipaintThree }
  from "asciipaint/three";

const pass = asciipaintThree(renderer);
pass.render(scene, camera);`;
---

<section class="three" id="three" aria-labelledby="three-title">
  <header class="row">
    <h2 class="label" id="three-title"><i>05</i> THREE.JS</h2>
    <p class="sub">Swap renderer.render for pass.render. Same scene, same camera, painted in the same frame.</p>
  </header>

  <div class="stage" data-three-stage>
    <canvas role="img" aria-label="A three.js scene of a torus knot, a sphere and a gem, painted live"></canvas>
    <p class="call"><code>pass.render(scene, camera)</code></p>
  </div>

  <div class="row">
    <p class="label">SCENE.TS</p>
    <div class="use">
      <PlainCode id="three-code" file="scene.ts" code={code} />
      <p class="sub">Graded with ACES Filmic and output as sRGB, so lit scenes keep their highlights.</p>
    </div>
  </div>
</section>

<script>
  import { autoRender } from "asciipaint";
  import { glyphFont } from "../lib/glyph-font";
  import { loadScene } from "../lib/playground/sources";
  import { cellAt, coarse, resolve } from "../lib/resolve";
  import { canPaint } from "../lib/still";

  // three.js (~150 kB gzip) loads only when the section is within 800 px, through the same module
  // promise as the playground's 3D source. Without WebGL2 the stage stays black and nothing loads.
  const stage = document.querySelector<HTMLElement>("[data-three-stage]");
  const canvas = stage?.querySelector("canvas");

  async function start(stage: HTMLElement, canvas: HTMLCanvasElement) {
    const three = await loadScene();
    const scene = three.stage3d(canvas);
    // A new cell size needs a new pass; it reuses the renderer, so the context stays the same one.
    const pass = (scale: number) =>
      three.asciipaintThree(scene.renderer, { cell: cellAt([2.4, 3.4], scale), font: glyphFont(), background: "#000000" });
    let paint = pass(coarse());
    let lost = false;
    let shown: (() => void) | undefined;
    autoRender(
      { canvas, resize: () => paint.resize() },
      (now) => {
        scene.frame(now, paint);
        stage.dataset.painting = "";
        shown?.();
      },
      {
        onContextLost: () => {
          lost = true;
          delete stage.dataset.painting;
        },
      },
    );
    // It starts on big cells and resolves to the real ones once the stage is well in view.
    const seen = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        seen.disconnect();
        shown = resolve((scale) => {
          if (lost) return;
          paint.dispose();
          paint = pass(scale);
        });
      },
      { threshold: 0.35 },
    );
    seen.observe(stage);
  }

  if (stage && canvas && canPaint()) {
    const near = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        near.disconnect();
        start(stage, canvas).catch((e: unknown) => console.warn("asciipaint couldn't start the three.js scene; its stage stays black.", e));
      },
      { rootMargin: "800px" },
    );
    near.observe(stage);
  }
</script>

<style>
  /* The hero's language carried on: black, hairlines, small type. */
  .three {
    background: var(--black);
    color: var(--lavender);
  }
  .row {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: var(--space-4);
    padding: 28px max(16px, 2.2vw);
    border-top: 1px solid var(--line);
  }
  .label {
    margin: 0;
    font: 500 11px/13px var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .label i {
    margin-right: 8px;
    font-style: normal;
    color: var(--lilac);
  }
  .sub {
    max-width: 62ch;
    margin: 0;
    font: 400 15px/23px var(--font-body);
    color: var(--muted);
  }

  /* The scene, full width, tagged with the one call that paints it. */
  .stage {
    position: relative;
    height: min(72svh, 640px);
    min-height: 320px;
    border-top: 1px solid var(--line);
    background: var(--black);
  }
  .stage canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .call {
    position: absolute;
    left: max(16px, 2.2vw);
    top: 20px;
    margin: 0;
    padding: 7px 10px;
    background: var(--black);
    font: 500 11px/13px var(--font-mono);
    letter-spacing: 0.04em;
    pointer-events: none;
  }
  .call code {
    font: inherit;
  }
  .use {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    gap: var(--space-5);
  }

  @media (max-width: 899px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
      padding: 24px 16px;
    }
    .use {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
    }
  }
  @media (max-width: 640px) {
    /* A tall stage would crop the scene at both sides, so the phone keeps a landscape one. */
    .stage {
      height: auto;
      min-height: 0;
      aspect-ratio: 4 / 3;
    }
    .call {
      top: 12px;
    }
  }
</style>
