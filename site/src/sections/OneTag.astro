---
import Band from "../components/Band.astro";
import Chip from "../components/Chip.astro";
import CodeCard from "../components/CodeCard.astro";
import PaintedTitle from "../components/PaintedTitle.astro";
import { LOGOS } from "../lib/logos";

const code = `import "asciipaint/element";

<ascii-img src="orbit.svg"></ascii-img>
<ascii-img src="chevrons.png"></ascii-img>`;

const bullets = [
  "SVG with only a viewBox, or a transparent PNG",
  "Transparent pixels stay paper",
  "One shared WebGL context for every tag",
  "Fires paint and error events, like <img>",
];

// Every other mark ships as a PNG; each card leans by a fixed amount, as in the frame.
const TILT = [-2, 1.5, -1, 2, 1, -1.5, 2.5, -2, -1, 1.5, -2.5, 3];
const stickers = LOGOS.map((logo, i) => {
  const kind = i % 2 ? "png" : "svg";
  return { file: `${logo.name.toLowerCase()}.${kind}`, kind, tilt: TILT[i] ?? 0 };
});
---

<Band tone="lavender" grain id="one-tag">
  <div class="wrap">
    <Chip label="03 — ONE TAG" tone="black" />
    <div class="title">
      <PaintedTitle text="One tag." palette="title" band="lavender" />
    </div>
    <div class="cols">
      <div class="copy">
        <p class="sub">
          Import the element once, then use it like &lt;img&gt;. Every &lt;ascii-img&gt; on the page shares one WebGL
          context, so a whole wall of them costs one GPU setup.
        </p>
        <CodeCard file="logos.html" code={code} lang="jsx" />
        <ul class="bullets">{bullets.map((b) => <li>{b}</li>)}</ul>
      </div>
      <ul class="wall" aria-label="Twelve logos, each painted by its own <ascii-img>">
        {
          stickers.map((s, i) => (
            <li class="sticker" style={`--tilt: ${s.tilt}deg`} data-sticker={i} data-kind={s.kind}>
              <div class="art" data-art />
              <p class="label">
                <span data-file>{s.file}</span>
                <span class="tag">{s.kind.toUpperCase()}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Band>

<script>
  import { LOGOS, night, pngUrl, svgUrl } from "../lib/logos";
  import { canPaint } from "../lib/still";

  // Each sticker is a real <ascii-img> (they all share one WebGL context), made once the wall is
  // near. Without WebGL2 the element can't paint, so a plain <img> shows the unpainted mark.
  const wall = document.querySelector<HTMLElement>("#one-tag .wall");
  if (wall) {
    const near = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        near.disconnect();
        wall.querySelectorAll<HTMLElement>("[data-sticker]").forEach(async (sticker) => {
          const i = Number(sticker.dataset.sticker);
          const logo = LOGOS[i];
          const art = sticker.querySelector("[data-art]");
          if (!logo || !art) return;
          const mark = night(logo);
          let src = svgUrl(mark);
          if (sticker.dataset.kind === "png") {
            try {
              src = await pngUrl(mark);
            } catch (error) {
              console.warn(`${logo.name}: its PNG couldn't be made, so the SVG is shown instead.`, error);
            }
          }
          const el = canPaint() ? document.createElement("ascii-img") : new Image();
          el.setAttribute("alt", `${logo.name} logo`);
          el.setAttribute("background", "#0A0D1F");
          el.setAttribute("src", src);
          art.append(el);
        });
      },
      { rootMargin: "200px" },
    );
    near.observe(wall);
  }
</script>

<style>
  .wrap {
    max-width: 1312px;
    margin: 0 auto;
  }
  .title {
    margin: var(--space-5) 0 var(--space-4);
  }
  .title :global(.painted-text) {
    font-size: clamp(64px, 20.5vw, 258px);
    letter-spacing: -0.02em;
  }
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 556px) minmax(0, 1fr);
    gap: var(--space-5) 52px;
    align-items: start;
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
  }
  .sub {
    margin: 0;
    font: 400 var(--body-lg) / 1.55 var(--font-body);
  }
  .bullets {
    display: grid;
    gap: 10px;
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
    font: 500 13px/1.4 var(--font-mono);
  }
  .bullets li {
    position: relative;
    padding-left: 18px;
  }
  .bullets li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.35em;
    width: 8px;
    height: 8px;
    background: var(--violet);
    border: 1px solid var(--navy);
  }

  /* The wall: navy cards on a 6 px cobalt edge, each leaning a little. */
  .wall {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px 18px;
    margin: 0;
    padding: 0 6px 6px 0;
    list-style: none;
  }
  .sticker {
    padding: 8px 8px 0;
    background: var(--navy);
    color: var(--lavender);
    border: 1.5px solid var(--black);
    box-shadow: 6px 6px 0 var(--cobalt);
    transform: rotate(var(--tilt));
  }
  .art {
    aspect-ratio: 1;
  }
  .art > :global(*) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .label {
    display: flex;
    justify-content: space-between;
    gap: 4px;
    margin: 0;
    padding: 8px 2px 10px;
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .tag {
    color: var(--blue-light);
  }

  @media (max-width: 1099px) {
    .cols {
      grid-template-columns: minmax(0, 1fr);
    }
    .copy {
      max-width: 640px;
    }
  }
  @media (max-width: 767px) {
    .title {
      margin: var(--space-3) 0 var(--space-3);
    }
    .sub {
      font-size: var(--body-md);
    }
    .wall {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px 12px;
    }
    .sticker {
      padding: 6px 6px 0;
    }
    .label {
      gap: 2px;
      padding: 6px 0 8px;
      font-size: 9px;
      letter-spacing: 0;
    }
  }
</style>
