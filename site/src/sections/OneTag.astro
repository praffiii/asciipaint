---
import PlainCode from "../components/PlainCode.astro";
import { LOGOS } from "../lib/logos";

const code = `import "asciipaint/element";

<ascii-img src="orbit.svg"></ascii-img>
<ascii-img src="chevrons.png"></ascii-img>`;

const facts = [
  "SVG with only a viewBox, or a transparent PNG",
  "Transparent pixels stay paper",
  "One shared WebGL context for every tag",
  "Fires paint and error events, like <img>",
];

// Every other mark ships as a PNG.
const stickers = LOGOS.map((logo, i) => {
  const kind = i % 2 ? "png" : "svg";
  return { file: `${logo.name.toLowerCase()}.${kind}`, kind };
});
---

<section class="tag" id="one-tag" aria-labelledby="tag-title">
  <header class="row">
    <h2 class="label" id="tag-title"><i>04</i> ONE TAG</h2>
    <p class="sub">
      Import the element once, then use it like &lt;img&gt;. Every &lt;ascii-img&gt; on the page shares one WebGL
      context, so a whole wall of them costs one GPU setup.
    </p>
  </header>

  <ul class="wall" aria-label="Twelve logos, each painted by its own <ascii-img>">
    {
      stickers.map((s, i) => (
        <li class="sticker" style={`--i: ${i}`} data-sticker={i} data-kind={s.kind}>
          <div class="art" data-art />
          <p class="cap">
            <span data-file>{s.file}</span>
            <span class="kind">{s.kind.toUpperCase()}</span>
          </p>
        </li>
      ))
    }
  </ul>

  <div class="row">
    <p class="label">LOGOS.HTML</p>
    <div class="use">
      <PlainCode id="tag-code" file="logos.html" code={code} lang="jsx" />
      <ul class="facts">{facts.map((f) => <li>{f}</li>)}</ul>
    </div>
  </div>
</section>

<script>
  import { LOGOS, night, pngUrl, svgUrl } from "../lib/logos";
  import { canPaint } from "../lib/still";

  // Each logo is a real <ascii-img> (they all share one WebGL context), made once the wall is
  // near. Without WebGL2 the element can't paint, so a plain <img> shows the unpainted mark.
  const wall = document.querySelector<HTMLElement>("#one-tag .wall");
  if (wall) {
    const near = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        near.disconnect();
        wall.querySelectorAll<HTMLElement>("[data-sticker]").forEach(async (sticker) => {
          const i = Number(sticker.dataset.sticker);
          const logo = LOGOS[i];
          const art = sticker.querySelector("[data-art]");
          if (!logo || !art) return;
          const mark = night(logo);
          let src = svgUrl(mark);
          if (sticker.dataset.kind === "png") {
            try {
              src = await pngUrl(mark);
            } catch (error) {
              console.warn(`${logo.name}: its PNG couldn't be made, so the SVG is shown instead.`, error);
            }
          }
          const el = canPaint() ? document.createElement("ascii-img") : new Image();
          el.setAttribute("alt", `${logo.name} logo`);
          el.setAttribute("background", "#000000");
          el.setAttribute("src", src);
          art.append(el);
        });
      },
      { rootMargin: "200px" },
    );
    near.observe(wall);

    // The logos land one after another once the wall is well in view. They are only held back
    // here, in script, so without it they are simply there.
    wall.dataset.wall = "waiting";
    const seen = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        seen.disconnect();
        wall.dataset.wall = "in";
      },
      { threshold: 0.15 },
    );
    seen.observe(wall);
  }
</script>

<style>
  /* The hero's language carried on: black, hairlines, small type. */
  .tag {
    background: var(--black);
    color: var(--lavender);
  }
  .row {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: var(--space-4);
    padding: 28px max(16px, 2.2vw);
    border-top: 1px solid var(--line);
  }
  .label {
    margin: 0;
    font: 500 11px/13px var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .label i {
    margin-right: 8px;
    font-style: normal;
    color: var(--lilac);
  }
  .sub {
    max-width: 62ch;
    margin: 0;
    font: 400 15px/23px var(--font-body);
    color: var(--muted);
  }

  /* The wall: twelve logos flat on one grid, a hairline between each. */
  .wall {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }
  .sticker {
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    transition:
      opacity 300ms var(--ease-out),
      translate 300ms var(--ease-out);
    transition-delay: calc(var(--i) * 40ms);
  }
  .sticker:nth-child(6n) {
    border-right: 0;
  }
  .sticker:nth-last-child(-n + 6) {
    border-bottom: 0;
  }
  .wall[data-wall="waiting"] .sticker {
    opacity: 0;
    translate: 0 12px;
  }
  .art {
    aspect-ratio: 1;
    padding: 12%;
  }
  .art > :global(*) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .cap {
    display: flex;
    justify-content: space-between;
    gap: 4px;
    margin: 0;
    padding: 0 12px 12px;
    font: 500 11px/13px var(--font-mono);
    letter-spacing: 0.04em;
    white-space: nowrap;
    color: var(--muted);
  }
  .kind {
    color: var(--muted-light);
  }

  .use {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    gap: var(--space-5);
  }
  .facts {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    font: 400 15px/23px var(--font-body);
    color: var(--muted);
  }
  .facts li {
    padding-top: 10px;
    border-top: 1px solid var(--line);
  }
  .facts li:first-child {
    padding-top: 0;
    border-top: 0;
  }

  @media (max-width: 899px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
      padding: 24px 16px;
    }
    .use {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
    }
    .wall {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .sticker:nth-child(6n) {
      border-right: 1px solid var(--line);
    }
    .sticker:nth-child(4n) {
      border-right: 0;
    }
    .sticker:nth-last-child(-n + 6) {
      border-bottom: 1px solid var(--line);
    }
    .sticker:nth-last-child(-n + 4) {
      border-bottom: 0;
    }
  }
  @media (max-width: 640px) {
    .wall {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .sticker:nth-child(4n) {
      border-right: 1px solid var(--line);
    }
    .sticker:nth-child(3n) {
      border-right: 0;
    }
    .sticker:nth-last-child(-n + 4) {
      border-bottom: 1px solid var(--line);
    }
    .sticker:nth-last-child(-n + 3) {
      border-bottom: 0;
    }
    .cap {
      padding: 0 6px 8px;
      font-size: 9px;
      letter-spacing: 0;
    }
  }
</style>
