---
import pkg from "../../../package.json";
import DocsNav from "../components/DocsNav.astro";
import Keycap from "../components/Keycap.astro";
import TocRail from "../components/TocRail.astro";
import { agentPrompt } from "../data/agent-prompt";
import { href, NAV, neighbours } from "../data/nav";
import Base from "./Base.astro";

interface Props {
  slug: string;
  title: string;
  description: string;
  /** The page's source file, relative to `site/`. */
  source: string;
}
const { slug, title, description, source } = Astro.props;
const github = "https://github.com/praffiii/asciipaint";
const group = NAV.find((g) => g.items.some((i) => i.slug === slug))?.group;
const { prev, next: nextPage } = neighbours(slug);
// After the last page, the next stop is the playground (frame 44:33).
const next = nextPage ?? NAV.flatMap((g) => g.items).find((i) => i.external);
---

<Base title={`${title} · asciipaint docs`} description={description}>
  <header class="top">
    <div class="brand">
      <Keycap href="/">asciipaint</Keycap>
      <span class="where">/ docs</span>
    </div>
    <nav class="site" aria-label="Site">
      <Keycap href="/playground/" tone="violet">Playground</Keycap>
      <Keycap href={github}>GitHub ↗</Keycap>
      <span class="ver">v{pkg.version}</span>
    </nav>
    <button class="keycap keycap-dark open" type="button" aria-haspopup="dialog" aria-controls="docs-menu" data-menu-open>
      Menu <span aria-hidden="true">☰</span>
    </button>
  </header>

  <dialog id="docs-menu" class="menu" aria-label="Docs menu">
    <div class="top">
      <div class="brand">
        <Keycap href="/">asciipaint</Keycap>
        <span class="where">/ docs</span>
      </div>
      <form method="dialog">
        <button class="keycap keycap-violet" type="submit">Close <span aria-hidden="true">✕</span></button>
      </form>
    </div>
    <div class="menu-nav">
      <DocsNav current={slug}>
        <div class="extra">
          <Keycap href={github}>GitHub ↗</Keycap>
          <Keycap href="https://www.npmjs.com/package/asciipaint">npm ↗</Keycap>
        </div>
      </DocsNav>
    </div>
  </dialog>

  <pre id="agent-prompt" hidden>{agentPrompt(Astro.site!.origin)}</pre>

  <div class="docs" data-docs>
    <div class="side" data-side>
      <div class="side-in"><DocsNav current={slug} /></div>
    </div>
    <main id="main" class="read">
      <article>
        <p class="crumb">{group && <>{group}<span aria-hidden="true">&nbsp;&nbsp;/&nbsp;&nbsp;</span></>}{title}</p>
        <h1>{title}</h1>
        <p class="intro">{description}</p>
        <nav class="chips" aria-label="On this page" data-toc-chips hidden></nav>
        <slot />
      </article>
      <nav class="pn" aria-label="Previous and next">
        {
          prev && (
            <a class="card" href={href(prev)} rel="prev">
              <span class="dir"><span aria-hidden="true">←&nbsp;&nbsp;</span>Previous</span>
              <span class="name">{prev.title}</span>
            </a>
          )
        }
        {
          next && (
            <a class="card card-next" href={href(next)} rel={nextPage ? "next" : undefined}>
              <span class="dir">Next<span aria-hidden="true">&nbsp;&nbsp;→</span></span>
              <span class="name">{next.title}</span>
            </a>
          )
        }
      </nav>
      <TocRail edit={`${github}/edit/main/site/${source}`} />
    </main>
  </div>
</Base>

<script>
  const menu = document.querySelector<HTMLDialogElement>("#docs-menu");
  const open = document.querySelector<HTMLButtonElement>("[data-menu-open]");
  if (menu && open) {
    open.addEventListener("click", () => menu.showModal());
    menu.addEventListener("close", () => open.focus());
    // A followed link closes it, and so does coming back to this page from the back-forward cache.
    menu.addEventListener("click", (e) => {
      if (e.target instanceof Element && e.target.closest("a")) menu.close();
    });
    addEventListener("pageshow", (e) => {
      if (e.persisted) menu.close();
    });
  }
</script>

<style>
  :global(html):has(.menu[open]) {
    overflow: hidden;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html) {
      scroll-behavior: smooth;
    }
  }

  /* Top bar */
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    padding: 12px 32px;
    background: var(--black);
    border-bottom: 1px solid var(--line);
  }
  .brand,
  .site {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .site {
    gap: 10px;
  }
  .where {
    font: 400 13px/1 var(--font-mono);
    color: var(--muted);
  }
  .ver {
    margin-left: 6px;
    padding: 6px 8px;
    border: 1px solid var(--line);
    font: 400 11px/1 var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .open {
    display: none;
  }

  /* Phone menu */
  .menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--black);
    color: var(--lavender);
  }
  /* It drops in from the top bar and leaves faster than it came. Browsers without
     @starting-style or allow-discrete just show and hide it. */
  .menu {
    translate: 0 -100%;
    transition:
      translate 150ms var(--ease-out),
      overlay 150ms allow-discrete,
      display 150ms allow-discrete;
  }
  .menu[open] {
    translate: 0 0;
    transition-duration: 250ms;
    transition-timing-function: var(--ease-drawer);
  }
  @starting-style {
    .menu[open] {
      translate: 0 -100%;
    }
  }
  .menu::backdrop {
    background: var(--black);
    opacity: 0;
    transition:
      opacity 150ms ease,
      overlay 150ms allow-discrete,
      display 150ms allow-discrete;
  }
  .menu[open]::backdrop {
    opacity: 1;
    transition-duration: 250ms;
  }
  @starting-style {
    .menu[open]::backdrop {
      opacity: 0;
    }
  }
  .menu form {
    margin: 0;
  }
  .menu-nav {
    --nav-size: 16px;
    padding: var(--space-4) var(--gutter) var(--space-5);
  }
  .extra {
    display: flex;
    gap: 10px;
    margin-top: var(--space-4);
  }

  /* Body */
  .docs {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    min-height: calc(100vh - 62px);
  }
  .side {
    border-right: 1px solid var(--line);
    background: var(--black);
  }
  .side-in {
    position: sticky;
    top: 0;
    max-height: 100vh;
    overflow-y: auto;
    padding: var(--space-5) 20px;
  }
  .read {
    --focus: var(--lavender);
    display: grid;
    grid-template-columns: minmax(0, 760px) 252px;
    grid-template-rows: auto 1fr;
    column-gap: 72px;
    align-content: start;
    padding: 56px 20px 96px 56px;
    background: var(--black);
    color: var(--lavender);
  }
  .read > :global(.rail) {
    grid-column: 2;
    grid-row: 1 / span 2;
  }

  /* Reading */
  article {
    min-width: 0;
  }
  .crumb {
    margin: 0 0 var(--space-3);
    font: 500 11px/1.4 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--lilac);
  }
  h1 {
    font-size: 40px;
    line-height: 1.05;
    letter-spacing: -0.015em;
    color: var(--lavender);
  }
  .intro {
    max-width: 640px;
    margin: var(--space-4) 0 var(--space-5);
    font-size: var(--body-lg);
    line-height: 1.55;
    color: var(--muted);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: calc(-1 * var(--space-3)) 0 var(--space-5);
  }
  .chips[hidden] {
    display: none;
  }
  .chips :global(a) {
    padding: 5px 8px;
    border: 1px solid var(--line);
    font: 500 12px/1 var(--font-mono);
    color: var(--lavender);
    text-decoration: none;
  }
  .chips :global(a[aria-current]) {
    border-color: var(--lavender);
    background: var(--lavender);
    color: var(--black);
  }
  article :global(h2) {
    margin: var(--space-5) 0 var(--space-3);
    font-size: 22px;
    letter-spacing: -0.01em;
    color: var(--lavender);
    scroll-margin-top: var(--space-4);
  }
  article :global(p),
  article :global(li) {
    max-width: 680px;
    line-height: 1.65;
  }
  article :global(:not(pre) > code) {
    padding: 1px 5px;
    background: var(--ink-2);
    color: var(--lilac);
    font-size: 0.9em;
  }
  /* Every code block is a code card (MDX blocks come through CodePre). */
  article :global(figure.card) {
    margin: var(--space-3) 0 var(--space-5);
  }

  /* Previous and next */
  .pn {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: var(--space-3) var(--space-3) 18px;
    color: var(--lavender);
    border: 1px solid var(--line);
    text-decoration: none;
  }
  .card:hover {
    border-color: var(--lavender);
  }
  .card:hover .name {
    color: var(--lilac);
  }
  .card-next {
    grid-column: 2;
    align-items: flex-end;
    text-align: right;
  }
  .dir {
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .name {
    font: 400 17px/1.2 var(--font-mono);
  }

  /* Tablet: the rail folds into chips under the intro. */
  @media (max-width: 1239px) {
    .read {
      grid-template-columns: minmax(0, 760px);
      padding: 48px 40px 80px;
    }
    .read > :global(.rail) {
      display: none;
    }
  }
  @media (min-width: 1240px) {
    .chips {
      display: none;
    }
  }

  /* Phone: the sidebar moves into the menu. */
  @media (max-width: 959px) {
    .top {
      padding: 12px var(--gutter);
    }
    .site,
    .side {
      display: none;
    }
    .open {
      display: inline-block;
    }
    .docs {
      grid-template-columns: minmax(0, 1fr);
    }
    .read {
      padding: 32px var(--gutter) 64px;
    }
    h1 {
      font-size: 32px;
    }
    .intro {
      font-size: var(--body-md);
    }
    .pn {
      grid-template-columns: minmax(0, 1fr);
    }
    .card-next {
      grid-column: 1;
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
